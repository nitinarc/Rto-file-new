<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Result</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-green-50 to-teal-100 min-h-screen flex items-center justify-center p-4">

  <div class="bg-white/80 backdrop-blur-lg p-8 rounded-3xl shadow-2xl max-w-md w-full border border-white/20 text-center">
    <div class="text-5xl mb-3">✅</div>
    <h1 class="text-2xl font-bold text-gray-800">Processing Complete!</h1>

    <div class="bg-gray-100/70 p-4 rounded-xl mt-4 text-left text-sm">
      <p><span class="font-semibold">📂 Folders:</span> <%= folders.length %></p>
      <p><span class="font-semibold">📄 Total Pages:</span> <%= folders.reduce((acc, f) => acc + f.files.length, 0) %></p>
    </div>

    <a href="/download/<%= Date.now() %>"
       class="mt-6 inline-block w-full bg-gradient-to-r from-green-500 to-teal-500 hover:from-green-600 hover:to-teal-600 text-white font-semibold py-3 px-4 rounded-xl transition duration-200 shadow-lg shadow-green-200">
      ⬇️ Download ZIP
    </a>

    <p class="text-xs text-gray-400 mt-4">⚠️ ZIP will be deleted after download.</p>
    <a href="/" class="text-sm text-blue-600 hover:underline mt-3 inline-block">⬅️ Upload Another File</a>
  </div>

</body>
</html>