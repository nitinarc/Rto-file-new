<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PDF Split & Merge Tool</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen flex items-center justify-center p-4">

  <div class="bg-white/80 backdrop-blur-lg p-8 rounded-3xl shadow-2xl max-w-md w-full border border-white/20">
    <div class="text-center mb-6">
      <div class="text-4xl mb-2">📄</div>
      <h1 class="text-2xl font-bold text-gray-800">PDF Split & Merge Tool</h1>
      <p class="text-gray-500 text-sm mt-1">Upload, Split, Merge & Download — All in One</p>
    </div>

    <!-- ✅ Upload Form (बिना Folder Name के) -->
    <form action="/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
      
      <div class="relative border-2 border-dashed border-gray-300 rounded-xl p-6 text-center hover:border-blue-500 transition cursor-pointer bg-gray-50/50">
        <input type="file" name="pdfFile" accept=".pdf" required
               class="absolute inset-0 opacity-0 cursor-pointer">
        <div class="text-3xl mb-1">📁</div>
        <p class="text-gray-600 text-sm">Click or drag to upload PDF</p>
        <p class="text-gray-400 text-xs mt-1">Max 50MB</p>
      </div>

      <button type="submit"
              class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold py-3 px-4 rounded-xl transition duration-200 shadow-lg shadow-blue-200">
        🚀 Upload & Process
      </button>
    </form>

    <p class="text-xs text-center text-gray-400 mt-4">
      🔒 Your files are processed locally and deleted after download.
    </p>
  </div>

</body>
</html>